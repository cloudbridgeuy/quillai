{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../../app/node_modules/react"],
      "react/*": ["../../../app/node_modules/react/*"],
      "react-dom": ["../../../app/node_modules/react-dom"],
      "react-dom/*": ["../../../app/node_modules/react-dom/*"]
    }
  }
}
