# Copy to quillai.env at the workspace root, then uncomment your settings.
# cargo xtask dev loads this file into the API process only.
# Precedence: CLI flags > shell environment > quillai.env.
# Values are literal; optional single/double quotes, no expansion or escapes.
# Comments use their own lines. Optional leading export is accepted.
# QUILLAI_AI_API_KEY=your-api-key
# QUILLAI_AI_MODEL=your-chat-completions-model-id
# OpenCode Zen: chat-completions models only.
# QUILLAI_AI_BASE_URL=https://opencode.ai/inference/openai/v1
# OpenAI default when QUILLAI_AI_BASE_URL is unset: https://api.openai.com/v1
# QUILLAI_AI_MODELS_FILE=models.json
