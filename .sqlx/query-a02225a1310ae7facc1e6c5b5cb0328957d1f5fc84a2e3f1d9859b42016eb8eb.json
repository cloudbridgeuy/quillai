{
  "db_name": "SQLite",
  "query": "SELECT p.id AS \"piece_id!\", p.universe_id, p.title, p.label, p.format, p.parent_id, datetime(r.created_at) AS \"changed_at!\", c.series_id, c.book_id, c.id AS chapter_id FROM active_pieces p JOIN piece_revisions r ON r.piece_id = p.id AND r.rev = (SELECT MAX(rev) FROM piece_revisions WHERE piece_id = p.id) LEFT JOIN legacy_chapters c ON c.piece_id = p.id WHERE p.shape = 'leaf' ORDER BY datetime(r.created_at) DESC, p.id DESC LIMIT ?",
