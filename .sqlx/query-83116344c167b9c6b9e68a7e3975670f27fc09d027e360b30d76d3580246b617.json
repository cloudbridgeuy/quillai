  "query": "SELECT s.lore_entry_id, s.id AS \"id!\", s.name, s.point_id, s.visible_text, s.hidden_notes FROM lore_entry_states s JOIN timeline_points p ON p.id = s.point_id JOIN lore_entries e ON e.id = s.lore_entry_id WHERE e.universe_id = ? AND e.deleted_at IS NULL AND s.deleted_at IS NULL ORDER BY p.position, p.id, s.id",
